// Default settings
let currentFontSize = '24px';
let currentTheme = 'default';
let smartJumpEnabled = false;
let compactModeEnabled = false;

const applyFontSize = () => {
    const selectors = [
        '.CodeMirror-scroll',
        '.CodeMirror',
        '.CodeMirror-code',
        '.CodeMirror-line',
        '.CodeMirror-gutter-element',
        '.CodeMirror-sizer',
        '.CodeMirror-measure',
        '.CodeMirror-cursor'
    ];

    const allElements = document.querySelectorAll(selectors.join(','));
    allElements.forEach(el => {
        el.style.setProperty('font-size', currentFontSize, 'important');
    });

    const cursors = document.querySelectorAll('.CodeMirror-cursor');
    cursors.forEach(cursor => {
        cursor.style.setProperty('height', currentFontSize, 'important');
    });
};

const applyTheme = () => {
    const editor = document.querySelector('.CodeMirror');
    if (!editor) return;

    const textElements = document.querySelectorAll('.CodeMirror-code, .CodeMirror-line, .CodeMirror-gutter-element');
    const gutters = document.querySelectorAll('.CodeMirror-gutter');

    if (currentTheme === 'dark') {
        // Professional Dark Mode
        editor.style.setProperty('background-color', '#2c2c2c', 'important');
        textElements.forEach(el => el.style.setProperty('color', '#e0e0e0', 'important'));
        gutters.forEach(g => {
            g.style.setProperty('background-color', '#1e1e1e', 'important');
            g.style.setProperty('color', '#888888', 'important');
        });
    } else if (currentTheme === 'contrast') {
        // High Contrast Neon Mode
        editor.style.setProperty('background-color', '#000000', 'important');
        textElements.forEach(el => el.style.setProperty('color', '#00FF00', 'important'));
        gutters.forEach(g => {
            g.style.setProperty('background-color', '#000000', 'important');
            g.style.setProperty('color', '#AAAAAA', 'important');
        });
    } else if (currentTheme === 'dracula') {
        // Dracula Theme
        editor.style.setProperty('background-color', '#282a36', 'important');
        textElements.forEach(el => el.style.setProperty('color', '#f8f8f2', 'important'));
        gutters.forEach(g => {
            g.style.setProperty('background-color', '#343746', 'important');
            g.style.setProperty('color', '#6272a4', 'important');
        });
    } else if (currentTheme === 'solarized') {
        // Solarized Light
        editor.style.setProperty('background-color', '#fdf6e3', 'important');
        textElements.forEach(el => el.style.setProperty('color', '#657b83', 'important'));
        gutters.forEach(g => {
            g.style.setProperty('background-color', '#eee8d5', 'important');
            g.style.setProperty('color', '#93a1a1', 'important');
        });
    } else if (currentTheme === 'ocean') {
        // Ocean Blue
        editor.style.setProperty('background-color', '#001f3f', 'important');
        textElements.forEach(el => el.style.setProperty('color', '#7fdbff', 'important'));
        gutters.forEach(g => {
            g.style.setProperty('background-color', '#001a35', 'important');
            g.style.setProperty('color', '#3a86ff', 'important');
        });
    } else {
        // Reset to Default
        editor.style.removeProperty('background-color');
        textElements.forEach(el => el.style.removeProperty('color'));
        gutters.forEach(g => {
            g.style.removeProperty('background-color');
            g.style.removeProperty('color');
        });
    }
};

const refreshEditor = () => {
    window.dispatchEvent(new Event('resize'));
};

const focusSqlEditor = () => {
    const editor = document.querySelector('.CodeMirror');
    if (editor) {
        const textarea = editor.querySelector('textarea');
        if (textarea) textarea.focus();
    } else {
        const fallback = document.querySelector('textarea[name="sql"]');
        if (fallback) fallback.focus();
    }
};

const jumpToSqlTab = () => {
    const sqlLink = Array.from(document.querySelectorAll('a')).find(a =>
        a.textContent.trim() === 'SQL' || a.href.includes('route=/sql') || a.href.includes('sql.php')
    );
    if (sqlLink) {
        sqlLink.click();
    } else {
        // Fallback redirection
        const url = new URL(window.location.href);
        url.searchParams.set('route', '/sql');
        window.location.href = url.toString();
    }
};

chrome.storage.sync.get(['fontSize', 'themeMode', 'autoJump', 'compactMode'], (result) => {
    if (result.fontSize) {
        currentFontSize = result.fontSize + 'px';
    }
    if (result.themeMode) {
        currentTheme = result.themeMode;
    }
    if (result.autoJump !== undefined) {
        smartJumpEnabled = result.autoJump;
    }
    if (result.compactMode !== undefined) {
        compactModeEnabled = result.compactMode;
    }
    applyFontSize();
    applyTheme();
    refreshEditor();

    if (compactModeEnabled) {
        document.body.classList.add('pma-compact-mode');
    }
});

chrome.runtime.onMessage.addListener((request, sender, sendResponse) => {
    if (request.action === 'updateFontSize') {
        currentFontSize = request.size + 'px';
        applyFontSize();
        refreshEditor();
    } else if (request.action === 'updateTheme') {
        currentTheme = request.mode;
        applyTheme();
    } else if (request.action === 'updateAutoJump') {
        smartJumpEnabled = request.enabled;
    } else if (request.action === 'updateCompactMode') {
        compactModeEnabled = request.enabled;
        if (compactModeEnabled) {
            document.body.classList.add('pma-compact-mode');
        } else {
            document.body.classList.remove('pma-compact-mode');
        }
    }
});

// Keyboard Shortcuts
window.addEventListener('keydown', (e) => {
    if (e.ctrlKey && e.shiftKey && e.key === 'G') {
        e.preventDefault();
        jumpToSqlTab();
    }

    if (e.ctrlKey && (e.key === '=' || e.key === '+')) {
        e.preventDefault();
        const newSize = parseInt(currentFontSize) + 2;
        currentFontSize = newSize + 'px';
        chrome.storage.sync.set({ fontSize: newSize }, () => {
            applyFontSize();
            refreshEditor();
        });
    }

    if (e.ctrlKey && e.key === '-') {
        e.preventDefault();
        const newSize = parseInt(currentFontSize) - 2;
        if (newSize >= 12) {
            currentFontSize = newSize + 'px';
            chrome.storage.sync.set({ fontSize: newSize }, () => {
                applyFontSize();
                refreshEditor();
            });
        }
    }
});

const observer = new MutationObserver((mutations) => {
    let needsUpdate = false;
    for (const mutation of mutations) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'style') {
            needsUpdate = true;
            break;
        }
    }
    if (needsUpdate) {
        applyFontSize();
        applyTheme();
    }
});

// Optimized Smart Jump to avoid multiple redirects on one alert
const smartJumpObserver = new MutationObserver((mutations) => {
    if (smartJumpEnabled) {
        const successAlert = document.querySelector('.alert-success');
        if (successAlert && !successAlert.dataset.jumped) {
            successAlert.dataset.jumped = 'true';
            setTimeout(() => {
                jumpToSqlTab();
            }, 2000);
        }
    }
});

smartJumpObserver.observe(document.body, {
    childList: true,
    subtree: true
});

observer.observe(document.body, {
    attributes: true,
    subtree: true,
    attributeFilter: ['style']
});

applyFontSize();
applyTheme();
refreshEditor();

setInterval(() => {
    const cursors = document.querySelectorAll('.CodeMirror-cursor');
    cursors.forEach(cursor => {
        if (cursor.style.height !== currentFontSize) {
            cursor.style.setProperty('height', currentFontSize, 'important');
        }
    });
}, 200);

// Auto-focus on load
window.addEventListener('DOMContentLoaded', focusSqlEditor);
window.addEventListener('load', focusSqlEditor);
